# EnglishMaster Agent - 环境变量模板
# 用法：cp .env.example .env，然后填入真实值

# ════════════════════════════════════════════
# AI 服务（对话/出题/批改）
# ════════════════════════════════════════════

# MiniMax M3（OpenAI 兼容接口）
# 申请：platform.minimax.io
MINIMAX_API_KEY=sk-cp-your-key-here
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Anthropic（备用，可选）
# 申请：console.anthropic.com
ANTHROPIC_API_KEY=

# ════════════════════════════════════════════
# RAG 向量存储
# ════════════════════════════════════════════
# 选一个：pinecone / faiss / qdrant / chroma / pgvector
VECTOR_STORE_TYPE=pinecone

# --- Pinecone（默认，托管云）---
# 申请：app.pinecone.io
PINECONE_API_KEY=your-pinecone-key
PINECONE_HOST=https://your-index-host.svc.aped-4627-b74a.pinecone.io
PINECONE_INDEX_NAME=xsjkndb01
PINECONE_ENVIRONMENT=us-east-1

# --- FAISS（本地）---
# 装：pip install faiss-cpu
# FAISS_INDEX_PATH=./data/faiss_index

# --- Qdrant（本地服务端）---
# 启服务：docker run -p 6333:6333 qdrant/qdrant
# 装：pip install qdrant-client
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION=englishmaster

# --- Chroma ---
# 装：pip install chromadb
# CHROMA_PATH=./data/chroma
# CHROMA_COLLECTION=englishmaster

# --- pgvector ---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/dbname

# ════════════════════════════════════════════
# Embedding 模型
# ════════════════════════════════════════════
# ⚠️ E5 模型：文档嵌入加 "passage: "，查询嵌入加 "query: " 前缀
# 1024 维（与 Pinecone Index 匹配）
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# ════════════════════════════════════════════
# 认证
# ════════════════════════════════════════════
# JWT 密钥：openssl rand -base64 32 生成（≥ 32 字节）
JWT_SECRET=change-me-to-a-random-32-byte-string-please

# ════════════════════════════════════════════
# 数据库
# ════════════════════════════════════════════
DATABASE_URL=sqlite+aiosqlite:///./database/app.db

# ════════════════════════════════════════════
# 应用配置
# ════════════════════════════════════════════
APP_ENV=development          # development | test | production
APP_SECRET_KEY=change-me-in-production
MAX_CONTEXT_CHUNKS=5         # RAG 检索返回的最大片段数
MAX_TOKENS=2048              # AI 单次输出最大 token

# ════════════════════════════════════════════
# Claude 模型（备用，对话可选）
# ════════════════════════════════════════════
CLAUDE_MODEL=claude-sonnet-4-6

# ════════════════════════════════════════════
# 前端
# ════════════════════════════════════════════
FRONTEND_URL=http://localhost:3000

# ════════════════════════════════════════════
# 国内网络（可选）
# ════════════════════════════════════════════
# HuggingFace 镜像（首次下载 embedding 模型用）
HF_ENDPOINT=https://hf-mirror.com
# HTTPS 代理（如果需要）
# HTTPS_PROXY=http://127.0.0.1:7890
